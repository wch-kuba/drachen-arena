    {
      "name": "Gold Coin Button",
      "kind": "button",
      "refersTo": "button-gold",
      "description": "The single primary action per screen, full width at thumb height.",
      "html": "<button class=\"ds-btn-gold\">Los geht’s!</button>",
      "css": ":host{--rock-0:#041c22;--rock-1:#072830;--rock-2:#0b3540;--rock-3:#10444f;--rock-4:#165562;--tq-700:#0c7a76;--tq-500:#17a39c;--tq-300:#3fd3c6;--tq-100:#b4f0e7;--gold-800:#8a5414;--gold-600:#c98426;--gold-500:#e2a23c;--gold-300:#f7c86e;--gold-100:#ffe7b5;--glass:#e6f6f2;--glass-dim:#c7e6df;--ink:#05262c;--ink-soft:#2a5058;--foam:#eafbf7;--foam-soft:#a6d3cc;--coral:#ff8a6b;--coral-100:#ffe1d6;--legend-gelb:#ffe03a;--legend-gruen:#3dbb5a;--legend-blau:#2f7de1;--outline:4px;--radius-plaque:22px;--tap:2.9rem;--ease-out:cubic-bezier(0.16,1,0.3,1);--ease-settle:cubic-bezier(0.34,1.4,0.64,1)}.ds-btn-gold{font-family:Andika,system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:3.4rem;width:100%;padding:0 1.5rem;border:var(--outline) solid var(--ink);border-radius:999px;background:radial-gradient(120% 140% at 50% 20%,var(--gold-100) 0%,var(--gold-300) 38%,var(--gold-500) 72%,var(--gold-600) 100%);color:var(--ink);font-size:1.4rem;font-weight:700;box-shadow:inset 0 0 0 3px var(--gold-300),inset 0 0 0 6px var(--gold-600),0 8px 18px rgb(0 0 0/.45);transition:transform 120ms var(--ease-out);cursor:pointer}.ds-btn-gold:active{transform:translateY(3px) scale(.98)}.ds-btn-gold:focus-visible{outline:4px solid var(--gold-300);outline-offset:3px}.ds-btn-gold:disabled{background:var(--glass-dim);box-shadow:0 4px 10px rgb(0 0 0/.3);color:var(--ink-soft)}"
    },
    {
      "name": "Round Button",
      "kind": "button",
      "refersTo": "button-round",
      "description": "Sea-glass circle for close and read-aloud.",
      "html": "<button class=\"ds-btn-round\" aria-label=\"Vorlesen\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 9h4l5-4v14l-5-4H4z\"/><path d=\"M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12\"/></svg></button>",
      "css": ":host{--rock-0:#041c22;--rock-1:#072830;--rock-2:#0b3540;--rock-3:#10444f;--rock-4:#165562;--tq-700:#0c7a76;--tq-500:#17a39c;--tq-300:#3fd3c6;--tq-100:#b4f0e7;--gold-800:#8a5414;--gold-600:#c98426;--gold-500:#e2a23c;--gold-300:#f7c86e;--gold-100:#ffe7b5;--glass:#e6f6f2;--glass-dim:#c7e6df;--ink:#05262c;--ink-soft:#2a5058;--foam:#eafbf7;--foam-soft:#a6d3cc;--coral:#ff8a6b;--coral-100:#ffe1d6;--legend-gelb:#ffe03a;--legend-gruen:#3dbb5a;--legend-blau:#2f7de1;--outline:4px;--radius-plaque:22px;--tap:2.9rem;--ease-out:cubic-bezier(0.16,1,0.3,1);--ease-settle:cubic-bezier(0.34,1.4,0.64,1)}.ds-btn-round{display:grid;place-items:center;width:var(--tap);height:var(--tap);border:var(--outline) solid var(--ink);border-radius:50%;background:var(--glass);color:var(--ink);box-shadow:0 4px 10px rgb(0 0 0/.35);cursor:pointer}.ds-btn-round svg{width:1.35rem;height:1.35rem}.ds-btn-round:active{transform:translateY(2px)}.ds-btn-round:focus-visible{outline:4px solid var(--gold-300);outline-offset:3px}"
